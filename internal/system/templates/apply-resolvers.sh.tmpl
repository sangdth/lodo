#!/bin/sh
# lodo: writes one /etc/resolver file per name it reads on standard input, one
# name per line. Installed by `lodo setup`, run as root through
# /etc/sudoers.d/lodo, removed by `lodo uninstall`. It reads the names from no
# path: it copies at most {{.MaxInput}} bytes of standard input, which its
# caller opened, into its own temporary directory and reads only that copy.
# It only creates files named by lines that match the name pattern, always with
# the same content, and only deletes files whose first line is the marker. An
# empty input deletes every file it wrote. It never prints a line it read from
# its input.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 022

dir={{sh .ResolverDir}}
pattern={{sh .Pattern}}
marker={{sh .Marker}}

/bin/mkdir -p "$dir"
work=$(/usr/bin/mktemp -d /tmp/lodo.XXXXXX)
trap '/bin/rm -rf "$work"' EXIT

# One byte past the cap tells a list that is too long from one that fits.
/usr/bin/head -c {{.ReadInput}} > "$work/list"
if [ "$(/usr/bin/wc -c < "$work/list")" -gt {{.MaxInput}} ]; then
	echo "lodo: the name list is longer than {{.MaxInput}} bytes" >&2
	exit 1
fi

# Valid names only. grep exits 1 when no line matches, which is fine.
/usr/bin/grep -E -x -e "$pattern" "$work/list" > "$work/names" || [ $? -eq 1 ]
skipped=$(/usr/bin/grep -c -v -E -x -e "$pattern" "$work/list" || [ $? -eq 1 ])

written=0
while IFS= read -r name; do
	if [ "${#name}" -gt {{.MaxLen}} ]; then
		skipped=$((skipped + 1))
		continue
	fi
	target="$dir/$name"
	if [ -e "$target" ] || [ -L "$target" ]; then
		first=
		IFS= read -r first < "$target" || :
		if [ "$first" != "$marker" ]; then
			echo "lodo: left $target alone: lodo did not write it" >&2
			continue
		fi
	fi
	/usr/bin/printf '%s\n' "$marker"{{range .Lines}} {{sh .}}{{end}} > "$work/file"
	/bin/chmod 644 "$work/file"
	/bin/mv -f "$work/file" "$target"
	written=$((written + 1))
done < "$work/names"

removed=0
for f in "$dir"/*; do
	[ -f "$f" ] && [ ! -L "$f" ] || continue
	first=
	IFS= read -r first < "$f" || :
	[ "$first" = "$marker" ] || continue
	if ! /usr/bin/grep -F -x -q -e "${f##*/}" "$work/names"; then
		/bin/rm -f "$f"
		removed=$((removed + 1))
	fi
done

if [ "$(/usr/bin/id -u)" -eq 0 ]; then
	/usr/bin/dscacheutil -flushcache
	/usr/bin/killall -HUP mDNSResponder 2>/dev/null || :
fi
echo "lodo: $written resolver files written, $removed removed, $skipped lines skipped"
