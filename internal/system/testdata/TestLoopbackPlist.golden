<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.lodo.loopback</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>for i in $(/usr/bin/seq 1 50); do /sbin/ifconfig lo0 alias 127.0.1.$i up; done</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
